msgctxt "Name"
msgid "KTextEditor KDataTool Plugin"
msgstr "KTextEditor-KDataTool-Plugin"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:62
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Hëllefsprogrammer, wéi Thésaurus an Rechtschreifkontroll, uschalten (wann "
"installéiert)"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:3
msgctxt "Name"
