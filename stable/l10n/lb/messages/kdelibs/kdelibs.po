#, no-c-format
msgid ""
"<qt>\n"
"<p>Click here to replace all occurrences of the unknown text with the text in "
"the edit box above (to the left).</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>Klickt hei fir all Optrieden vum onbekannten Text duerch den Text an der "
"Edit-Këscht uëwe lénks z'ersetzen.</p>\n"
"</qt>"

