#: runapplet.cpp:59
msgid "Run command:"
msgstr "Kommando ausféieren"

#: runapplet.cpp:170
msgid "< Run"
msgstr "< Ausféieren"

#: runapplet.cpp:177
msgid "Run >"
msgstr "Ausféieren >"

#: runapplet.cpp:226
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "Dir musst fir d'éischt e Kommando ugi wat ausgeféiert soll ginn, oder eng URL déi opgemat soll ginn."

#: runapplet.cpp:237
msgid ""
"Unable to log out properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace. Note, however, that your current session will "
"not be saved with a forced shutdown."
msgstr ""
"Kann iech net propper ofmellen.\n"
"De Sëtzungsmanager kann net kontaktéiert ginn. Dir kënnt versichen d'Ausschalten ze forcéieren an deems dir Ctrl+Alt+Zeréck-Tast dréckt. Beuecht awer w.e.g., dass är aktuell Sëtzung net gespäichert gëtt bei engem forcéierten Ausschalten."

#: runapplet.cpp:268
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>De Programmnumm oder Kommando <b>%1</b>\n"
"konnt net fonnt ginn. Iwwerpréift de Kommando\n"
"oder d'URL w.e.g. a versicht et nach eng Kéier</qt>"

#: runapplet.cpp:280
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt>Konnt <b>%1</b> net ausféieren.\n"
"Verbessert de Kommando oder d'URL w.e.g. a versicht et nach eng Kéier.</qt>"

